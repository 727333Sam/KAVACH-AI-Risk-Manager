# Razorpay Test API Credentials (from hackathon dashboard)
RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Database
DATABASE_URL=postgresql://riskmanager:riskmanager_dev@localhost:5432/razorpay_risk

# Redis
